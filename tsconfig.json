{
  "compilerOptions": {
	"outDir": "./dist",
  "baseUrl": ".",
  "inlineSourceMap": true,
  "inlineSources": true,
  "module": "commonjs",
  "target": "ES2020",
  "allowJs": true,
	"jsx": "react",
  "noImplicitAny": true,
  "moduleResolution": "node",
  "importHelpers": true,
  "isolatedModules": true,
	"strictNullChecks": true,
	"esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "lib": [
      "DOM",
      "ES2020"
    ]
  },
  "include": [
    "**/*.ts"
  ]
}